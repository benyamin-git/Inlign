{
  "name": "inlign",
  "private": true,
  "version": "0.1.0",
  "description": "Live mathematical notepad: draft solutions in plain text and let the notebook compute and check them as you type.",
  "license": "MIT",
  "author": "benyamin-git",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benyamin-git/Inlign.git"
  },
  "homepage": "https://github.com/benyamin-git/Inlign",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/env.mjs vite",
    "dev:lan": "node scripts/env.mjs vite --host 0.0.0.0 --port ${PORT:-7406} --strictPort",
    "build": "tsc -b && node scripts/env.mjs vite build",
    "preview": "node scripts/env.mjs vite preview",
    "postinstall": "node scripts/wasm-fallbacks.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/env.mjs vitest run",
    "test:watch": "node scripts/env.mjs vitest",
    "test:e2e": "node scripts/env.mjs playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "icons:native": "tauri icon public/icons/icon-512.png",
    "accents": "node scripts/generate-accents.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "android:init": "tauri android init",
    "android:apk": "tauri android build --apk",
    "version:set": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.47.0",
    "nerdamer": "2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@rolldown/binding-wasm32-wasi": "1.2.12",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "lightningcss": "npm:lightningcss-wasm@1.32.0"
  }
}
