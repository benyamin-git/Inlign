{
  "name": "inlign",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "pnpm build:wasm && pnpm --filter @inlign/web dev",
    "build": "pnpm build:wasm && pnpm --filter @inlign/web build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "pnpm build:wasm && pnpm --filter @inlign/web typecheck",
    "lint": "pnpm build:wasm && pnpm --filter @inlign/web lint",
    "format": "pnpm --filter @inlign/web format",
    "format:check": "pnpm --filter @inlign/web format:check",
    "test": "pnpm build:wasm && pnpm --filter @inlign/web test",
    "test:watch": "pnpm build:wasm && pnpm --filter @inlign/web test:watch",
    "test:e2e": "pnpm build && pnpm --filter @inlign/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript-eslint": "^8.72.1"
  }
}
